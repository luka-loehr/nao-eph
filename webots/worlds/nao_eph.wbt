WorldInfo {
  info [
    "nao-eph studio: the Lessing-Gymnasium NAO in a bright room with things to play with."
  ]
  title "nao-eph studio"
  # HULKs' walking engine is tuned for a 10 ms step and this foot friction.
  basicTimeStep 10
  FPS 30
  contactProperties [
    ContactProperties {
      coulombFriction [
        0.45
      ]
    }
  ]
}
Viewpoint {
  orientation 0.08 0.02 -0.996 3.05
  position 2.4 0.25 0.9
}
TexturedBackground {
  texture "noon_sunny_empty"
}
TexturedBackgroundLight {
  texture "noon_sunny_empty"
}
Floor {
  name "ground"
  size 90 90
  tileSize 3 3
  appearance Grass {
  }
}
# The house floor sits a few millimetres above the lawn.
Floor {
  translation 0 0 0.003
  name "house floor"
  size 6 6
  tileSize 1 1
  appearance Parquetry {
    type "light strip"
  }
}

# Back wall behind the robot, with a painting and a TV.
Wall {
  translation -3 0 0
  name "back wall"
  size 0.1 6 2.8
  appearance Roughcast {
    colorOverride 0.86 0.84 0.8
    textureTransform TextureTransform {
      scale 6 2.8
    }
  }
}
# Left wall with a big window.
Wall {
  translation -2.25 3 0
  rotation 0 0 1 1.5708
  name "left wall a"
  size 0.1 1.5 2.8
  appearance Roughcast {
    colorOverride 0.86 0.84 0.8
  }
}
Window {
  translation -0.6 3 0
  rotation 0 0 1 1.5708
  name "window"
  size 0.1 1.8 2.8
  bottomWallHeight 0.5
  windowHeight 1.8
  wallAppearance Roughcast {
    colorOverride 0.86 0.84 0.8
  }
}
Wall {
  translation 1.65 3 0
  rotation 0 0 1 1.5708
  name "left wall b"
  size 0.1 2.7 2.8
  appearance Roughcast {
    colorOverride 0.86 0.84 0.8
  }
}
# Front wall closes the room; the viewer hides whichever wall faces the camera.
Wall {
  translation 3 0 0
  name "front wall"
  size 0.1 6 2.8
  appearance Roughcast {
    colorOverride 0.86 0.84 0.8
    textureTransform TextureTransform {
      scale 6 2.8
    }
  }
}
# Right wall in a calm blue that matches the robot.
Wall {
  translation -0.75 -3 0
  rotation 0 0 1 1.5708
  name "right wall a"
  size 0.1 4.5 2.8
  appearance Roughcast {
    colorOverride 0.55 0.68 0.85
    textureTransform TextureTransform {
      scale 4.5 2.8
    }
  }
}
Door {
  translation 2 -3 0
  rotation 0 0 1 1.5708
  name "door"
  size 0.1 1 2.8
  canBeOpen FALSE
  frameHeight 2.1
  wallAppearance Roughcast {
    colorOverride 0.55 0.68 0.85
  }
}
Wall {
  translation 2.75 -3 0
  rotation 0 0 1 1.5708
  name "right wall b"
  size 0.1 0.5 2.8
  appearance Roughcast {
    colorOverride 0.55 0.68 0.85
  }
}
Radiator {
  translation -0.6 2.86 0.32
  rotation 0 0 1 -1.5708
  name "radiator"
}
Cabinet {
  translation 0.6 -2.72 0
  rotation 0 0 1 1.5708
  name "cabinet"
}
FlowerPot {
  translation 2.55 2.55 0
  name "flower pot"
}
# Framed print of the nao-eph banner.
Pose {
  translation -2.93 0.9 1.55
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.08 0.08 0.09
        roughness 0.5
        metalness 0
      }
      geometry Box {
        size 0.03 1.9 0.68
      }
    }
    Pose {
      translation 0.017 0 0
      rotation 0.57735 0.57735 0.57735 2.0944
      children [
        Shape {
          appearance PBRAppearance {
            baseColorMap ImageTexture {
              url [
                "textures/nao-eph-banner.png"
              ]
            }
            roughness 0.35
            metalness 0
          }
          geometry Plane {
            size 1.8 0.6
          }
        }
      ]
    }
  ]
}
Television {
  translation -2.9 -1.1 1.45
  name "tv"
}

