# The robot with toys around.
# HULKs' NAO V6 (full-detail CAD meshes), driven by hulk_webots as an extern controller.
NAO {
  translation 0 0 0.3334
  rotation 0 0 1 0
  name "NAO"
  controller "<extern>"
  supervisor TRUE
  secondaryColor 0.07 0.36 0.85
}
SoccerBall {
  translation 0.55 0.45 0.12
  name "ball"
}
RubberDuck {
  translation 0.45 -0.4 0.02
  rotation 0 0 1 2.6
  name "duck"
}
WoodenBox {
  translation -0.7 -0.95 0.15
  name "box 1"
  size 0.3 0.3 0.3
}
WoodenBox {
  translation -0.7 -0.95 0.45
  rotation 0 0 1 0.4
  name "box 2"
  size 0.3 0.3 0.3
}
WoodenBox {
  translation -0.35 -1.25 0.1
  rotation 0 0 1 0.9
  name "box 3"
  size 0.2 0.2 0.2
}

# ---------------------------------------------------------------------------------------------
# Outside: the NAO's little house, its yard and the street.
# ---------------------------------------------------------------------------------------------

# Slate gable roof; the viewer hides it when you zoom into the house.
Solid {
  translation 0 0 2.8
  name "roof"
  children [
    Pose {
      translation 0 1.6500 0.7000
      rotation 1 0 0 -0.4012
      children [
        DEF ROOF_PLANE Shape {
          appearance SlatePavement {
            textureTransform TextureTransform {
              scale 4 3
            }
          }
          geometry Box {
            size 6.8 3.685 0.12
          }
        }
      ]
    }
    Pose {
      translation 0 -1.6500 0.7000
      rotation 1 0 0 0.4012
      children [
        USE ROOF_PLANE
      ]
    }
    Shape {
      appearance PBRAppearance {
        baseColor 0.86 0.84 0.8
        roughness 0.9
        metalness 0
      }
      geometry IndexedFaceSet {
        coord Coordinate {
          point [
            3.05 -3.05 0, 3.05 3.05 0, 3.05 0 1.4
            -3.05 -3.05 0, -3.05 3.05 0, -3.05 0 1.4
          ]
        }
        coordIndex [
          0 1 2 -1 3 5 4 -1
        ]
      }
    }
  ]
}
# Wooden porch in front of the door and a stone path to the gate.
Solid {
  translation 2 -3.85 0.06
  name "porch"
  children [
    Shape {
      appearance RoughOak {
      }
      geometry Box {
        size 2.4 1.6 0.12
      }
    }
  ]
}
Solid {
  translation 2.3 -6.6 0.012
  name "garden path"
  children [
    Shape {
      appearance StonePavement {
        textureTransform TextureTransform {
          scale 1 4
        }
      }
      geometry Box {
        size 1.3 5.2 0.024
      }
    }
  ]
}

